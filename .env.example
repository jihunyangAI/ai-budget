# Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Neon Postgres (pooled connection string). `npm run db:env`로 자동 추가 가능
DATABASE_URL=postgresql://user:password@host-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Better Auth 세션 서명 키. `npm run auth:setup`이 없으면 자동 생성
BETTER_AUTH_SECRET=random_32_byte_secret
# (선택) 배포 시 로그인을 허용할 호스트. 기본값: localhost, 127.0.0.1, 192.168.*
# BETTER_AUTH_ALLOWED_HOSTS=myapp.com,*.vercel.app
